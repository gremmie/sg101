# Send-only mail for the host, installed on the VM as /etc/msmtprc (root:root,
# 600) with the token filled in. See cutover-runbook.md B14.
#
# msmtp-mta installs msmtp as /usr/sbin/sendmail, which is what cron, apt's
# unattended-upgrades and anything else on the host call. Each message is one
# connection to Postmark: no daemon, no queue, nothing listening on port 25. The
# cost of no queue is that a message sent while Postmark is unreachable is lost,
# with the error going to the caller. Accepted: the host sends a few messages a
# month, and the heartbeats cover the jobs that matter.
#
# The token is the application's own Postmark server token, the value of
# EMAIL_HOST_PASSWORD in .env; Postmark takes it as both user and password. The
# installed copy is root-only, so only root can send -- which is every caller on
# this host. Rotating the token means reinstalling this file as well as .env.
#
# The sender is rewritten, envelope and From header both, because Postmark
# refuses any address that is not on a verified domain, and cron's would be
# root@<hostname>. no_reply@ is the address jaguar's sender_canonical rewrites to.

defaults
auth           on
tls            on
tls_starttls   on
tls_trust_file system
syslog         LOG_MAIL
aliases        /etc/aliases

account        postmark
host           smtp.postmarkapp.com
# 587 and 2525 both measured open from the VM; 587 is what the application uses.
port           587
user           @POSTMARK_TOKEN@
password       @POSTMARK_TOKEN@
from           no_reply@surfguitar101.com
set_from_header on
# Otherwise a caller's `sendmail -f` replaces the envelope sender, and Postmark
# refuses whatever it names.
allow_from_override off

account default : postmark
