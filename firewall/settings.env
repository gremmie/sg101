# The origin firewall's settled settings, read by tools/origin_firewall.py and so
# by the Makefile's firewall-* targets. Each line is KEY=value. An environment
# variable of the same name overrides it, for an emergency change made without
# editing this file.
#
# No secrets here: the tool refuses LINODE_TOKEN in this file. The token comes
# from the environment or the login keychain (service sg101-linode-firewall).

FIREWALL_PROVIDER=linode
FIREWALL_LINODE_ID=175729041
# Decided when leopard was provisioned (Step 21 task 03, STATUS.md).
FIREWALL_SSH_FROM=anywhere
# The zone's SSL mode is Full, so Cloudflare reaches the origin on 443 only.
FIREWALL_HTTP=drop
