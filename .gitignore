# Mirrors .hgignore (carried over from the Mercurial repo). Kept in sync so the
# same artifacts stay untracked after the git migration.

# Python
*.pyc
*.pyo
__pycache__/

# Host virtualenv, for editor tooling only. The code runs in Docker; this
# exists so a language server can resolve imports. See DOCKER.md.
.venv/

# Editors / OS
*.swp
.DS_Store

# Secrets & local config (never commit)
secrets.json
# The whole directory, not a filename: Google's console hands you a service
# account key named after the project and a key id, and a rule naming only the
# file we meant to see would not match one downloaded straight into the repo.
secrets/
.env
.claude/settings.local.json

# Host state for the production stack: logs, the maintenance flag, and the
# content copied off the old host. See docker-compose.prod.yml.
/var/

# Logs / runtime
*.log
*.log.?
*.log.??
*.log.*.gz
celerybeat-schedule
celerybeat.pid
*.pid

# Databases / large binaries
*.db
*.mp3
.tags

# Production DB snapshots (real user PII — NEVER commit)
snapshots/*.sql
snapshots/*.sql.gz
snapshots/*.sql.bz2
snapshots/*.bz2
snapshots/*.gz
snapshots/*.dump
snapshots/*.zip
snapshots/*.tar
snapshots/*.tgz

# Static/served + media (user uploads)
static_root
media/avatars/users
media/badges
media/banners
media/downloads
media/podcast
media/potd
media/slideshow
media/smiley
media/user_photos

# Search index (legacy Xapian) + front-end build artifacts
sg101/xapian_index
sg101/node_modules
sg101/bower_components
tools/ssg101/output

# Coverage
.coverage
coverage.xml
htmlcov/
tools/pgloader/logs/
tools/pgloader/.sg101.rendered.load
