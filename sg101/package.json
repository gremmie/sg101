{
  "name": "sg101",
  "version": "1.0.0",
  "description": "SurfGuitar101.com stylesheet build",
  "private": true,
  "author": "Brian Neal <bgneal@gmail.com>",
  "license": "ISC",
  "scripts": {
    "build:css": "sass --no-source-map --quiet-deps --load-path=node_modules/foundation-sites/scss --load-path=node_modules/motion-ui/src scss/main.scss static/css/v3/main.min.css && postcss static/css/v3/main.min.css --replace --no-map",
    "watch:css": "sass --watch --no-source-map --quiet-deps --load-path=node_modules/foundation-sites/scss --load-path=node_modules/motion-ui/src scss/main.scss static/css/v3/main.min.css"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.0.0",
    "foundation-sites": "6.3.1",
    "motion-ui": "1.2.3",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.0"
  }
}
