# Keep the build context (and the COPY . /app layer) small and fast.
.hg
.git
.agents
.claude
*.pyc
*.pyo
__pycache__
*.log
*.log.*
.DS_Store
snapshots
static_serve
sg101/node_modules
sg101/bower_components
sg101/logs/*.log
media/user_photos
media/downloads
media/podcast
media/potd
media/banners
media/slideshow
*.sql
*.sql.gz
*.db
.env
# Keys and certificates. Without this, `COPY . /app` bakes every one of them
# into the image, where anyone holding the image can read them. The production
# stack mounts only what each service needs, at run time.
secrets
# Host virtualenv: macOS-architecture wheels that must not reach the image via
# `COPY . /app`. Note this does NOT keep it out of the running container -- the
# `.:/app` bind mount carries it in regardless, where it sits inert because
# nothing activates it.
.venv
