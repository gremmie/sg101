# Environment variables for SG101 (12-factor config).
#
# Copy to .env and fill in real values for local dev:  cp .env.example .env
# .env is git-ignored. In Docker, docker-compose loads this via `env_file:`;
# in CI it is seeded from this example; in production the host sets the vars.

# Django secret key. REQUIRED -- the app refuses to start without it.
SECRET_KEY=dev-only-insecure-change-me

# Which database engine to talk to: postgresql (the default) or mysql, which
# also needs `docker compose --profile mysql` to start its service. Host and
# port follow automatically from the service that runs the chosen engine;
# override DB_HOST/DB_PORT only for a database outside the Compose network.
DB_ENGINE=postgresql

# DB creds -- shared by both database services in docker-compose.yml, which are
# initialized with the same name/user/password (MYSQL_* and POSTGRES_*).
DB_NAME=sg101
DB_USER=sg101
DB_PASSWORD=sg101

# Google Calendar / OAuth (optional; blank disables the integration).
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_CREDENTIALS_PATH=

# AWS S3 for user photo uploads (optional).
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# Where those uploads go. The defaults below are what the settings already use
# and what tens of thousands of existing photo rows point at, so leave them
# alone unless the bucket actually moves -- a stored photo URL is absolute, so
# changing these does not restate where the old ones live.
# The host of USER_PHOTOS_BASE_URL must also appear in USER_IMAGES_SOURCES
# (sg101/settings/base.py), which is the whitelist of hosts members may
# reference in posts -- otherwise a photo uploads and shows in its gallery, but
# posting it to the forums is rejected as "Invalid image source". Settings
# refuse to load if the two disagree.
USER_PHOTOS_BUCKET=sg101.user.photos
USER_PHOTOS_BASE_URL=https://s3-us-west-1.amazonaws.com
USER_PHOTOS_REGION=us-west-1

# Google reCAPTCHA (optional).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mail. Unset, the defaults reproduce what ran before any of this was
# configurable: the console backend in development, the local relay in
# production. Point the site at a transactional provider by setting these, with
# no code change.
#
# NOTE the commented-out form below, and keep it. This file is loaded by
# docker-compose via `env_file:` and seeded into CI, so a variable listed here
# as `NAME=` is *set to the empty string*, not absent -- and an empty string
# beats the default in settings. For EMAIL_PORT and EMAIL_TIMEOUT that is not a
# subtle bug: int('') raises at settings-load time and nothing starts. Only the
# credential variables at the end are safe to list blank, their default being
# blank too. Uncomment a line to use it.
#
# EMAIL_BACKEND: console prints to stdout and sends nothing -- the right
# default for development. Production defaults to the SMTP backend. The test
# suite substitutes locmem automatically; do not set this for tests.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Host and port. Defaults: localhost:1025 in development, localhost:25 in
# production.
#EMAIL_HOST=smtp.postmarkapp.com
#EMAIL_PORT=587
# STARTTLS. Required on 587 with any external provider; false for a local relay.
#EMAIL_USE_TLS=True
# Seconds before a send gives up; defaults to 20. Django hands this to smtplib,
# where unset means *no timeout* -- harmless against a local socket, but against
# a remote provider a hung connection blocks the sending thread with no bound.
#EMAIL_TIMEOUT=20
# The address site mail is sent from, and the address Django's own error mail is
# sent from. SERVER_EMAIL matters more than it looks: Django's default is
# root@localhost, which the local relay accepted and a provider will reject --
# leave it unset and error reporting is the first thing to break after a
# cutover, exactly when it is needed. Both default to admin@surfguitar101.com.
#DEFAULT_FROM_EMAIL=admin@surfguitar101.com
#SERVER_EMAIL=admin@surfguitar101.com
# Local part of the no-reply address; the site's domain is appended to it.
#GPP_NO_REPLY_EMAIL=no_reply

# SMTP credentials. Blank means no authentication, which is what a local relay
# wants -- so unlike the settings above, these are safe to leave listed and
# empty. Postmark expects its *server API token* in BOTH fields; that is not a
# mistake, it is how their SMTP interface authenticates. Put the real token in
# .env or the production environment. Never commit it here.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
