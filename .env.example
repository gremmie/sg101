# Environment variables for SG101 (12-factor config).
#
# Copy to .env and fill in real values for local dev:  cp .env.example .env
# .env is git-ignored. In Docker, docker-compose loads this via `env_file:`;
# in CI it is seeded from this example; in production the host sets the vars.

# Django secret key. REQUIRED -- the app refuses to start without it.
SECRET_KEY=dev-only-insecure-change-me

# Which database engine to talk to: mysql (default) or postgresql. Both run in
# the Compose stack during the migration; this is the switch between them, and
# host/port follow automatically from the service that runs the chosen engine.
# Override DB_HOST/DB_PORT only for a database outside the Compose network.
DB_ENGINE=mysql

# DB creds -- shared by both database services in docker-compose.yml, which are
# initialized with the same name/user/password (MYSQL_* and POSTGRES_*).
DB_NAME=sg101
DB_USER=sg101
DB_PASSWORD=sg101

# Google Calendar / OAuth (optional; blank disables the integration).
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_CREDENTIALS_PATH=

# AWS S3 for user photo uploads (optional).
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Google reCAPTCHA (optional).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
