# The backup job's configuration. Copy to secrets/backup.env (git-ignored) and
# fill in. Not .env: that file is in every application container, and nothing
# that serves a web request needs a way into the backups.

# The two buckets. Nothing is shared with the media buckets the site serves from.
BACKUP_DB_BUCKET=
BACKUP_MEDIA_BUCKET=

# The job's own credential: s3:PutObject and s3:ListBucket on the two buckets and
# nothing that deletes -- backup/policy-writer.json. Never an admin key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Only for a provider other than AWS itself, e.g. https://<region>.linodeobjects.com
# AWS_ENDPOINT_URL=

# The heartbeat check's ping URL, e.g. https://hc-ping.com/<uuid>. The job pings
# <url>/start, <url> on success and <url>/fail.
HEARTBEAT_URL=
