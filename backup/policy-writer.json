{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListForSync",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::@DB_BUCKET@", "arn:aws:s3:::@MEDIA_BUCKET@"]
    },
    {
      "Sid": "WriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::@DB_BUCKET@/*", "arn:aws:s3:::@MEDIA_BUCKET@/*"]
    }
  ]
}
