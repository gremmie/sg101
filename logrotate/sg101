# Rotation for the Django and Apache log files, installed on the VM as
# /etc/logrotate.d/sg101. See cutover-runbook.md B10 and B11.
#
# Every path below assumes the checkout is at /svr/sg101, where it is on the
# production host. /svr, not /srv, is deliberate: it is the host's convention.
# The /srv paths in apache/ and docker-compose.prod.yml are a different thing,
# locations inside the proxy container. A checkout anywhere else needs these
# paths edited. The Django files live in <checkout>/var/log/django, which
# docker-compose.prod.yml mounts into web, worker and beat at /app/sg101/logs.
#
# Why rotation is out here rather than in the application: production's handlers
# are WatchedFileHandler, which never rotates and instead checks before each
# write whether the file at its path is still the one it opened. A dozen
# processes share this directory -- gunicorn's workers, the Celery worker and
# beat -- so rotation has to happen once for all of them. logrotate renames, and
# each process reopens on its next write.
#
# create, never copytruncate. copytruncate loses whatever is written between the
# copy and the truncate, and it is only needed for programs that cannot follow a
# rename -- which is exactly what WatchedFileHandler was chosen to avoid. `create`
# takes no mode or owner here on purpose: it then reuses the rotated file's own,
# which keeps working when the containers stop running as root.
#
# Sizes and counts are the floor, not a target: each matches what the in-process
# handler used, so no file keeps less than it does today. Measured on the old
# host 2026-09-20 -- sg101.log held 5.0 months across 10 backups, auth.log 20.4
# months across 5.

/svr/sg101/var/log/django/sg101.log {
    size 100k
    rotate 10
    missingok
    notifempty
    compress
    delaycompress
    create
}

# auth.log gets more backups than the handler kept, not fewer. Its history is
# why this whole approach was chosen over one stream per container: fail2ban
# reads it, and the 2026 registration-spam analysis ran on it. 12 compressed
# backups cost less disk than the 5 uncompressed ones do today, and they absorb
# the higher volume the new stack will produce -- INFO in production, and every
# gunicorn worker writing where one mod_wsgi daemon used to.
/svr/sg101/var/log/django/auth.log {
    size 2M
    rotate 12
    missingok
    notifempty
    compress
    delaycompress
    create
}

# These three do not exist on the old host at all -- they arrived with Steps 12,
# 16 and 17 -- so there is no retention to preserve and nothing to measure
# against. They take auth.log's shape because they are the same kind of file: a
# low-volume record kept for looking things up afterwards. email.log in
# particular is the per-message audit trail core.tasks.send_mail writes.
/svr/sg101/var/log/django/email.log
/svr/sg101/var/log/django/search.log
/svr/sg101/var/log/django/turnstile.log {
    size 2M
    rotate 5
    missingok
    notifempty
    compress
    delaycompress
    create
}

# Apache's logs, written by the proxy container into var/log/apache. Unlike the
# Django handlers, Apache holds its log open and follows a rename: after
# logrotate moves access.log aside, Apache goes on appending to the renamed file
# until it is told to reopen. postrotate tells it, with the same graceful reload
# `make prod-proxy-reload` uses, which lets requests in flight finish. Measured
# locally 2026-09-25: without the reload the next request landed in the renamed
# file; with it, in the new one.
#
# Weekly, as on the old host, but 26 weeks kept rather than 8: eight weeks is
# what nearly lost sg101's logs before they were archived (Step 21 task 01), and
# at ~17 MB a compressed week the half-year costs under half a gigabyte.
#
# sharedscripts: one reload for both files, not one each. The compose file is
# named with its full path so that compose finds the checkout's .env, which it
# needs even to run exec. A failed reload is not silenced: logrotate reports it,
# and cron mails the report.
/svr/sg101/var/log/apache/access.log
/svr/sg101/var/log/apache/error.log {
    weekly
    rotate 26
    missingok
    notifempty
    compress
    delaycompress
    create
    sharedscripts
    postrotate
        docker compose -f /svr/sg101/docker-compose.prod.yml exec -T proxy apache2ctl -k graceful
    endscript
}
