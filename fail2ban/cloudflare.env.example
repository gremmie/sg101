# The Cloudflare block list's settings, for tools/cloudflare_block_list.py:
# fail2ban's action and the blocklist-* targets. Copy to secrets/cloudflare.env
# (git-ignored), brian:brian 600, and fill in.

# An API token owned by the account, with Account Rule Lists edit and nothing
# else. Never the Global API Key.
CLOUDFLARE_API_TOKEN=

# The account that owns the list: the ID in the dashboard's URL.
CLOUDFLARE_ACCOUNT_ID=

# The IP list the WAF rule drops at the edge.
CLOUDFLARE_LIST_NAME=block_list
