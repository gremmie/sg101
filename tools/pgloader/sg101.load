/*
 * MySQL -> PostgreSQL conversion for SG101.
 *
 * Run through tools/pgloader/convert.sh, which fills the placeholders below
 * from the environment. Nothing here is environment-specific, so the same file
 * converts the dev snapshot and, at cutover, production.
 *
 * The target database is dropped and recreated by the wrapper before this
 * runs, so the conversion always starts from empty and can be repeated.
 */

LOAD DATABASE
     FROM     mysql://{{mysql_user}}:{{mysql_password}}@{{mysql_host}}/{{mysql_db}}
     INTO postgresql://{{pg_user}}:{{pg_password}}@{{pg_host}}/{{pg_db}}

 /* prefetch/batch sizes are held well below pgloader's defaults (100,000
  * prefetch rows) on purpose. forums_post has 463,221 rows whose bodies are
  * longtext, and at the default the reader buffers enough of them to exhaust
  * SBCL's 1GB heap and abort the run -- this build has no option to enlarge
  * it, so the fix is to stream in smaller pieces. */
 WITH include drop,
      create tables,
      create indexes,
      reset sequences,
      foreign keys,
      workers = 4,
      concurrency = 1,
      prefetch rows = 1000,
      batch rows = 1000,
      batch size = 20MB

 /* The dump came off MySQL 5.5 and forums_post is large; give the reader room
  * rather than letting a slow batch time the connection out. */
  SET MySQL PARAMETERS
      net_read_timeout  = '600',
      net_write_timeout = '600'

  SET work_mem to '64MB',
      maintenance_work_mem to '512MB'

 /* Integer widths. MySQL's int(11) reports a numeric precision of 10, and
  * pgloader's default rule sends anything with precision >= 10 to bigint --
  * so without this, 204 columns arrive 64-bit where Django's migrations build
  * them 32-bit, including every primary key. Step 10 set
  * DEFAULT_AUTO_FIELD to AutoField precisely to keep those 32-bit, and a
  * schema that disagrees with the migrations is a trap for every later one.
  *
  * Safe for this data: no int column anywhere holds a value above
  * 2,147,483,647, and the only two unsigned int columns are the generic
  * foreign keys comments_comment.object_id and tagging_taggeditem.object_id,
  * which Django models as PositiveIntegerField -- 32-bit as well.
  *
  * smallint likewise: django_admin_log.action_flag is smallint(5) unsigned,
  * which pgloader widens to integer, where Django's PositiveSmallIntegerField
  * wants smallint. */
  CAST type int with extra auto_increment to serial drop typemod,
       type int to integer drop typemod,
       type smallint with extra auto_increment to serial drop typemod,
       type smallint to smallint drop typemod,

 /* Django's GenericIPAddressField is inet on PostgreSQL; these are char(39)
  * in MySQL, which has no such type. Aligning them here, while the tables are
  * being rebuilt anyway, avoids leaving a char->inet AlterField to be
  * attempted during some later migration.
  *
  * forums_post.user_ip holds 370 empty strings out of 463,221, which inet
  * cannot represent. The column is nullable and an empty string means no
  * address was recorded, so NULL is the honest value. The other three
  * columns contain no empty or malformed values. */
 /* bio_userprofile.country is char(2) in production where models.py says
  * CharField(max_length=2), i.e. varchar. That looked like harmless vintage
  * drift until the site was tried on the converted database: MySQL strips
  * trailing spaces when reading CHAR, so an unset country comes back as '',
  * but PostgreSQL pads it and returns '  '. Two spaces are truthy, so
  * templates guarding on `{% if profile.country %}` call flag_icon('  '),
  * which raises -- and 12,854 of 15,227 profiles have no country set. */
       column bio_userprofile.country to varchar,

       column comments_comment.ip_address to inet drop typemod,
       column downloads_download.ip_address to inet drop typemod,
       column downloads_pendingdownload.ip_address to inet drop typemod,
       column forums_post.user_ip to inet drop typemod
              using empty-string-to-null

 /* Eight tables are latin1_swedish_ci while the other 83 are utf8. Without
  * this, their bytes are read as if they were UTF-8 and every non-ASCII
  * character is silently mangled. user_photos_photo (26,331 rows) and
  * bandmap_bandentry (1,066) are the ones with real text in them.
  *
  * cp1252, NOT latin1, and the difference is not academic. MySQL's "latin1"
  * is really Windows-1252: it gives 0x80-0x9F the printable characters cp1252
  * defines there, where ISO-8859-1 leaves them as C1 controls. pgloader's
  * LATIN-1 is the strict ISO standard, so declaring latin1 here converted
  * eight band entries wrong -- smart quotes and a trademark sign (0x92, 0x93,
  * 0x94, 0x99) became control characters. Only those eight rows of 1,066 use
  * such bytes, which is exactly how this kind of damage goes unnoticed.
  *
  * Named explicitly rather than by pattern: this list came from
  * information_schema and a regex would quietly stop matching if a table were
  * renamed. */
  DECODING TABLE NAMES MATCHING 'bandmap_bandentry',
                                'contests_contest',
                                'contests_contest_contestants',
                                'contests_contest_winners',
                                'countdown_event',
                                'django_migrations',
                                'messages_flag',
                                'user_photos_photo'
                             AS cp1252

 /* tinyint(1) -> boolean is pgloader's default for MySQL and is correct here:
  * all 34 such columns are Django BooleanFields and none holds a value
  * outside 0/1 (verified against the snapshot).
  *
  * No zero-date handling is declared because there are none: all 79 date,
  * datetime and timestamp columns were probed two ways (range comparison and
  * cast-to-text) and no 0000-00-00 value exists anywhere in the database. */

  ALTER SCHEMA '{{mysql_db}}' RENAME TO 'public'
;
